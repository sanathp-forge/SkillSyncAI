# SkillSync AI — Environment Configuration
# Copy to .env and fill in required values

# ============================================
# DATABASE (Required for backend)
# ============================================
DATABASE_URL=postgresql+asyncpg://skillsync:skillsync_dev@localhost:5432/skillsync_db

# ============================================
# APPLICATION SECRET (Required)
# ============================================
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# FRONTEND (Required)
# ============================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=SkillSync AI
VITE_DEMO_MODE=true

# ============================================
# LLM PROVIDER (Optional — enables AI features)
# ============================================
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai

# ============================================
# GITHUB OAUTH (Optional — enables GitHub evidence)
# ============================================
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:5173/auth/github/callback

# ============================================
# OBJECT STORAGE (Optional — defaults to local)
# ============================================
# S3_BUCKET_NAME=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=

# ============================================
# REDIS (Optional — enables background jobs)
# ============================================
# REDIS_URL=redis://localhost:6379/0

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# SANDBOX (Optional — enables real code execution)
# ============================================
# SANDBOX_ENABLED=false
# SANDBOX_URL=http://localhost:8001
# SANDBOX_TIMEOUT=10
# SANDBOX_MEMORY_LIMIT=128m

# ============================================
# DEMO MODE
# ============================================
DEMO_MODE=true
