# ============================================
# SkillSync AI — Git Ignore Configuration
# Strict Security for Credentials and Secrets
# ============================================

# Environment variables (CRITICAL: NEVER COMMIT)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Secrets, Certificates and Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
client_secrets.json
secrets/

# Dependencies
node_modules/
.pnp
.pnp.js
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Build outputs
dist/
dist-ssr/
build/
*.egg-info/
.eggs/
out/
.next/
.parcel-cache/

# Testing and Coverage
coverage/
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.tox/
.nox/

# Database and SQLite
*.db
*.sqlite
*.sqlite3

# Uploads directory (keep directory, ignore uploaded contents)
uploads/*
!uploads/.gitkeep

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs and Debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Docker overrides
docker-compose.override.yml
